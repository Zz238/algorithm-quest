{
  "name": "algo-quest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node scripts/check.mjs",
    "check:examples": "node scripts/check-guide-examples.mjs",
    "check:cloud": "node scripts/check-cloud.mjs && node scripts/check-account-session.mjs",
    "check:comments": "node scripts/check-comments.mjs",
    "check:reading": "node scripts/check-reading.mjs",
    "check:analytics": "node scripts/check-analytics.mjs",
    "admin": "node admin/server.mjs --open",
    "check:java": "node scripts/check-starter-java.mjs",
    "generate:java": "node scripts/generate-java-examples.mjs",
    "lint": "eslint src scripts tests *.config.js",
    "format:check": "prettier --check --ignore-unknown src/pages src/App.vue src/course-*.js src/course-figures.css src/learning-ux.css tests",
    "test:components": "vitest run",
    "test:browser": "playwright test",
    "build:offline": "vite build --mode offline --outDir dist-offline && node scripts/offline.mjs dist-offline",
    "generate:index": "node scripts/generate-course-index.mjs",
    "build:java-runner": "node scripts/build-java-runner.mjs",
    "check:coding": "node scripts/generate-course-index.mjs --check && node scripts/check-coding.mjs",
    "check:careers": "node scripts/check-career-projects.mjs",
    "measure:build": "node scripts/measure-build.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "morphicons": "2.0.2",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@playwright/test": "1.58.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.6",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "prettier": "3.8.1",
    "rollup": "4.65.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
