    "check:reading": "node scripts/check-reading.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@vitejs/plugin-vue": "6.0.10",
    "morphicons": "2.0.2",
    "vite": "7.3.7",
    "vue": "3.5.44"
  }
